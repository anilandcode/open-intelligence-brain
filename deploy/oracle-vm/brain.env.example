# /etc/open-brain/brain.env — chmod 600, owned by root. Never commit real values.

# Public origin: turns on the public-deployment boot guards and is the OAuth issuer.
BRAIN_PUBLIC_BASE_URL=https://brain.trulyagentic.io
BRAIN_CORS_ORIGINS=https://brain.trulyagentic.io
BRAIN_CORS_ORIGIN_REGEX=

# Local PostgreSQL 18 on the same VM (listen_addresses = 'localhost').
BRAIN_DATABASE_URL=postgresql+psycopg://brain:<password>@127.0.0.1:5432/brain

# Long random value (python -c "import secrets; print(secrets.token_urlsafe(48))").
BRAIN_OWNER_TOKEN=<owner-token>
BRAIN_SEED_DEMO=false

# Human sign-in.
BRAIN_IDENTITY_PROVIDER=google
BRAIN_IDENTITY_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
BRAIN_BOOTSTRAP_ALLOWED_EMAILS=<your-google-email>

# Set to true for ONE boot after rotating BRAIN_OWNER_TOKEN, then back to false.
BRAIN_RETIRE_LEGACY_OWNER_GRANTS=false

# mcp-auth-bridge control plane.
BRAIN_MAB_BRIDGE_URL=http://127.0.0.1:9090
BRAIN_MAB_SERVICE_TOKEN=<service-token>
