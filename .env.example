BRAIN_DATABASE_URL=sqlite:///./data/brain.db
BRAIN_OWNER_TOKEN=local-dev-token
BRAIN_SEED_DEMO=true
BRAIN_CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
# There is deliberately no VITE_API_TOKEN. Vite inlines every VITE_* variable
# into the JavaScript it serves, so one here would ship the owner token to the
# browser. The page asks for the token at runtime and keeps it in session
# storage; use the same value as BRAIN_OWNER_TOKEN above.


# Memory engine. Every setting is optional: unset means no engine, and the
# product still works on local deterministic extraction with no network calls.
# For a self-hosted install, first boot prints its own key, so point at it and
# paste that value here. Nothing to sign up for.
#   self-hosted:  http://localhost:6767   (key printed on first boot)
#   hosted:       https://api.supermemory.ai
BRAIN_SUPERMEMORY_BASE_URL=https://api.supermemory.ai
BRAIN_SUPERMEMORY_API_KEY=
BRAIN_SUPERMEMORY_TIMEOUT=10.0

# Refuses a hosted engine before any network call. The exception, not the default.
BRAIN_STRICT_LOCAL=false
