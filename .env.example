BRAIN_DATABASE_URL=sqlite:///./data/brain.db
BRAIN_OWNER_TOKEN=local-dev-token
BRAIN_SEED_DEMO=true
BRAIN_CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
# There is deliberately no VITE_API_TOKEN. Vite inlines every VITE_* variable
# into the JavaScript it serves, so one here would ship the owner token to the
# browser. The page asks for the token at runtime and keeps it in session
# storage; use the same value as BRAIN_OWNER_TOKEN above.


# Environment profile: development | production | test
# When BRAIN_ENV=production, startup fails closed if default tokens or insecure settings are used.
BRAIN_ENV=development

# Security & Rate Limiting
BRAIN_RATE_LIMIT_ENABLED=true
BRAIN_RATE_LIMIT_MAX_REQUESTS=120
BRAIN_RATE_LIMIT_WINDOW_SECONDS=60

# Native Span-Verified LLM Extraction Engine (v2.0.0)
# Uses any OpenAI-compatible /v1/chat/completions provider (OpenAI, Gemini, Groq, Ollama, vLLM).
# Verifies all extracted claims with verify_span against verbatim source characters before review.
BRAIN_LLM_EXTRACTION_ENABLED=false
BRAIN_LLM_BASE_URL=https://api.openai.com/v1
BRAIN_LLM_API_KEY=
BRAIN_LLM_MODEL=gpt-4o-mini
BRAIN_LLM_TEMPERATURE=0.0
BRAIN_LLM_TIMEOUT=30.0

# Memory engine (legacy Supermemory provider).
# Unset when using native LLM extraction or local deterministic extraction.
BRAIN_SUPERMEMORY_BASE_URL=https://api.supermemory.ai
BRAIN_SUPERMEMORY_API_KEY=
BRAIN_SUPERMEMORY_TIMEOUT=10.0

# Refuses a hosted engine before any network call. The exception, not the default.
BRAIN_STRICT_LOCAL=false

# Jev shadow decision provider (optional). The evaluation endpoint reads the
# URL from here only — never from a request parameter — so no API caller can
# point the server at an arbitrary internal host.
BRAIN_JEV_URL=

